<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".GroupExpenseApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GroupExpenseManagement">


        <activity
            android:name="com.exercise.groupexpensemanagement.ui.config.ConfigActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="com.exercise.groupexpensemanagement.ui.login.LoginActivity"
            android:exported="true"/>

        <activity android:name=".ui.main.MainScreenActivity"
            android:exported="true"
            android:theme="@style/Theme.MainScreen"/>

        <activity android:name="com.exercise.groupexpensemanagement.ui.groupcreate.CreateAGroupActivity"
            android:exported="true"
            android:theme="@style/Theme.MainScreen"/>

    </application>

</manifest>