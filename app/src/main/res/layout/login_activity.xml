<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="@dimen/small"
    android:paddingTop="@dimen/very_large">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_login"
        android:layout_gravity="center"/>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/textView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        style="@style/TextHeading1.1"
        android:layout_gravity="center"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_search_box"
        android:layout_marginTop="@dimen/large"
        app:cardBackgroundColor="@color/box_background_color"
        app:cardCornerRadius="@dimen/corner_radius_home">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ic_username"
                android:layout_width="@dimen/small_icon"
                android:layout_height="@dimen/small_icon"
                android:layout_marginStart="@dimen/small"
                android:layout_marginEnd="@dimen/small"
                android:src="@drawable/ic_logo_username" />

            <EditText
                android:id="@+id/edtUsername"
                style="@style/TextInsideSearchBox"
                android:layout_width="@dimen/layout_width_0"
                android:layout_height="wrap_content"
                android:layout_weight="@dimen/layout_weight_1"
                android:background="@null"
                android:hint="@string/hint_text"
                android:paddingStart="@dimen/more_large"
                android:paddingEnd="@dimen/small"
                android:singleLine="true"
                android:textColorHint="@color/hint_text_color" />
      </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="@dimen/height_search_box"
        android:layout_marginTop="@dimen/medium"
        app:cardBackgroundColor="@color/box_background_color"
        app:cardCornerRadius="@dimen/corner_radius_home">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ic"
                android:layout_width="@dimen/small_icon"
                android:layout_height="@dimen/small_icon"
                android:layout_marginStart="@dimen/small"
                android:layout_marginEnd="@dimen/small"
                android:src="@drawable/ic_logo_password" />
            <EditText
                android:id="@+id/edtPassword"
                style="@style/TextInsideSearchBox"
                android:layout_width="@dimen/layout_width_0"
                android:layout_height="wrap_content"
                android:layout_weight="@dimen/layout_weight_1"
                android:background="@null"
                android:hint="@string/hint_text_2"
                android:paddingStart="@dimen/more_large"
                android:paddingEnd="@dimen/small"
                android:singleLine="true"
                android:textColorHint="@color/hint_text_color"
                android:inputType="textPassword"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <com.google.android.material.button.MaterialButton
        style="@style/TextButton"
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/super_large"
        android:paddingVertical="@dimen/small"
        android:paddingHorizontal="@dimen/large"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/tiny"
        android:layout_marginBottom="@dimen/small"
        android:text="@string/btn_login"
        app:cornerRadius="@dimen/corner_radius_home" />

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/forgot"
        android:layout_gravity="center"
        style="@style/Text_Option"
        android:layout_marginTop="@dimen/medium"/>

    <com.google.android.material.textview.MaterialTextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/or"
        android:layout_gravity="center"
        style="@style/Text_Option"
        android:layout_marginTop="@dimen/medium"/>

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_search_box"
        android:layout_marginTop="@dimen/medium"
        app:cardBackgroundColor="@color/box_background_color"
        app:cardCornerRadius="@dimen/corner_radius_home"
        android:layout_gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/ic_google"
                android:layout_width="@dimen/small_icon"
                android:layout_height="@dimen/small_icon"
                android:layout_marginStart="@dimen/small"
                android:layout_marginEnd="@dimen/small"
                android:src="@drawable/google" />

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/google"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/tiny"
                android:layout_marginEnd="@dimen/medium"
                style="@style/Text_Option"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
    <androidx.cardview.widget.CardView
    android:layout_width="wrap_content"
    android:layout_height="@dimen/height_search_box"
    android:layout_marginTop="@dimen/medium"
    app:cardBackgroundColor="@color/box_background_color"
    app:cardCornerRadius="@dimen/corner_radius_home"
    android:layout_gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/ic_face"
            android:layout_width="@dimen/small_icon"
            android:layout_height="@dimen/small_icon"
            android:layout_marginStart="@dimen/small"
            android:layout_marginEnd="@dimen/small"
            android:src="@drawable/facebook" />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/facebook"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/tiny"
            android:layout_marginEnd="@dimen/medium"
            style="@style/Text_Option"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/very_large"
        android:layout_gravity="center">
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/option_register"
            android:layout_gravity="center"
            style="@style/Text_Option"
            android:layout_marginEnd="@dimen/small"
            />
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/register"
            android:layout_gravity="center"
            style="@style/Text_Option_Register" />

    </LinearLayout>




</LinearLayout>