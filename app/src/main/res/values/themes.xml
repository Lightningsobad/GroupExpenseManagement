<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.GroupExpenseManagement" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/white</item>
        <item name="colorPrimaryVariant">@color/primary_color</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/white</item>
        <!-- Customize your theme here. -->

        <item name="android:windowBackground">@color/white</item>

        <item name="colorControlNormal">@android:color/white</item>

        <item name="materialButtonStyle">@style/Widget.MyApp.Button.Rounded</item>
    </style>

    <style name="Theme.MainScreen" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary_color</item>
        <item name="android:statusBarColor">@color/primary_color</item>
    </style>

    <style name="Widget.MyApp.Button.Rounded" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="backgroundTint">@color/primary_color</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="TextHeading2" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="fontFamily">@font/canva_sans_bold</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="TextHeading1" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="fontFamily">@font/anton_regular</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:lineSpacingMultiplier">1</item>
        <item name="android:textSize">@dimen/medium_large_lv2</item>
    </style>

    <style name="TextHeading1.1" parent="TextAppearance.MaterialComponents.Headline3">
        <item name="fontFamily">@font/anton_regular</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:lineSpacingExtra">0dp</item>
        <item name="android:lineSpacingMultiplier">1</item>
        <item name="android:textSize">@dimen/more_large</item>
    </style>

    <style name="TextButton" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="fontFamily">@font/canva_sans_bold</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/medium_text</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:letterSpacing">@dimen/letter_spacing_button</item>
    </style>

    <style name="Text_Option" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="fontFamily">@font/canva_sans_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/hint_text_color</item>
        <item name="android:textSize">@dimen/medium_text</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:letterSpacing">@dimen/letter_spacing_button</item>
    </style>

    <style name="Text_Option_Register" parent="TextAppearance.MaterialComponents.Headline1">
        <item name="fontFamily">@font/canva_sans_medium</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:textColor">@color/primary_color</item>
        <item name="android:textSize">@dimen/medium_text</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:letterSpacing">@dimen/letter_spacing_button</item>
    </style>

    <style name="TextInsideSearchBox" parent="TextAppearance.MaterialComponents.Body2">
        <item name="fontFamily">@font/canva_sans_regular</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>